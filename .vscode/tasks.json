{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wm build",
      "type": "shell",
      "command": "gcc ./wm/main.c -o ./out/wm -lX11",
      "problemMatcher": "$gcc",
    },
    {
      "label": "wm run",
      "dependsOn": "wm build",
      "type": "shell",
      "command": "DISPLAY=:1 ./out/wm",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3,
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^___$",
          "endsPattern": "MiniWM started",
        },
      },
    },
    {
      "label": "wallpaper serve",
      "type": "shell",
      "command": "pnpm exec serve ./src",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3,
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "┌",
          "endsPattern": "┘",
        },
      },
    },
    {
      "label": "wallpaper open",
      "dependsOn": "wallpaper serve",
      "type": "shell",
      "command": "DISPLAY=:1 chromium --no-sandbox --disable-dev-shm-usage --class=webdesktopwallpaper --user-data-dir=\"$HOME/.config/webdesktopwallpaper\" --app=http://localhost:3000",
      "isBackground": true,
      "problemMatcher": [],
    },
    {
      "label": "xterm open",
      "dependsOn": "wm run",
      "type": "shell",
      "command": "DISPLAY=:1 xterm",
      "isBackground": true,
      "problemMatcher": [],
    },
  ],
}
